<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>pl.fullstackdeveloper</groupId>
    <artifactId>shop</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
     Kierunek zależności między modułami jest wymuszany przez build:
     app -> orders -> payments-api <- payments, a wszystkie -> common.
     orders NIE zależy od payments, więc import payments.domain nie skompiluje się.
    -->
    <modules>
        <module>common</module>
        <module>payments-api</module>
        <module>payments</module>
        <module>orders</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <build>
        <plugins>
            <!--
             JPMS pilnuje granic w czasie kompilacji. Testy (i aplikację Spring Boot uruchamianą z fat jara)
             wykonujemy na classpath - frameworki testowe i Spring intensywnie używają refleksji.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pl.fullstackdeveloper</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.fullstackdeveloper</groupId>
                <artifactId>payments-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.fullstackdeveloper</groupId>
                <artifactId>payments</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.fullstackdeveloper</groupId>
                <artifactId>orders</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
